# Readfine — STAGING environment template.
#
# Copy to .env.staging and fill in. This mirrors a production .env on purpose:
# staging runs with DEBUG=false so it exercises the same strict runtime as prod
# and catches "works on dev, breaks on the server" issues before they ship.
# .env.staging is gitignored; this template is committed.
#
# Generate FRESH keys — do NOT reuse production's (staging is throwaway):
#   SECRET_KEY:     python3 -c "import secrets; print(secrets.token_hex(32))"
#   ENCRYPTION_KEY: python3 -c "import secrets; print(secrets.token_hex(16))"   # 32 chars = 32 bytes

# ── Database (throwaway test data; separate volume from prod) ──────────────────
DB_NAME=readfine
DB_USER=readfine
DB_PASSWORD=change-me-staging
DATABASE_URL=postgresql+asyncpg://readfine:change-me-staging@db:5432/readfine

# ── Security (staging-only — never the production keys) ────────────────────────
# With DEBUG=false the app REFUSES to start while these are left at placeholders.
SECRET_KEY=change-me
ENCRYPTION_KEY=changemechangemechangemechangeme

# ── Application ────────────────────────────────────────────────────────────────
DEBUG=false
ALLOWED_HOSTS=["staging.example.com"]

# Client IP resolution (rate limiting & login lockout). Set these to match how
# you expose staging — they must mirror your real proxy chain or the login
# lockout reads the wrong client IP. See .env.example for the full explanation.
#   N = number of trusted reverse proxies in front (e.g. 1 for nginx only).
TRUSTED_PROXY_COUNT=1
# Trust Cloudflare's CF-Connecting-IP header — ONLY when the origin firewall
# restricts inbound 80/443 to Cloudflare IP ranges.
TRUST_CLOUDFLARE=false

# Host port binding for the app (compose interpolation). Default is loopback
# only (127.0.0.1:8001 — safe). A containerised reverse proxy on the SAME host
# reaching it via host.docker.internal/host-gateway CANNOT connect to a
# loopback-bound port, so uncomment this; keep the host/network firewall
# restricting inbound to 80/443 (+22) so 8001 stays private.
#STAGING_BIND=0.0.0.0

# ── Seed admin (created on first boot; remove these two lines afterwards) ──────
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-me
