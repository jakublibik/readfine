{
  "id": "/app",
  "name": "Readfine",
  "short_name": "Readfine",
  "description": "Your feeds, filtered and summarised.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#141414",
  "theme_color": "#141414",
  "share_target": {
    "action": "/share-target",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "/static/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/static/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/static/images/landing/desktop_toppicks.webp",
      "sizes": "2000x1250",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Top picks: articles from every feed, sorted by relevance"
    },
    {
      "src": "/static/images/landing/desktop_reading.webp",
      "sizes": "2000x1250",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Three-panel reading view with an AI summary"
    },
    {
      "src": "/static/images/landing/mobile_summary.webp",
      "sizes": "600x1290",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "AI summary"
    },
    {
      "src": "/static/images/landing/mobile_catchmeup.webp",
      "sizes": "600x1290",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Catch me up briefing"
    },
    {
      "src": "/static/images/landing/mobile_filters.webp",
      "sizes": "600x1290",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Filters and rules"
    }
  ]
}
