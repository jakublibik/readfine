# Database
DATABASE_URL=postgresql+asyncpg://readfine:readfine@localhost:5432/readfine

# Security – generate each ONCE and keep stable. Changing ENCRYPTION_KEY makes all
# stored API keys / feed passwords undecryptable. (Docker deploys: setup.sh does this for you.)
# With DEBUG=false the app REFUSES to start while these are left at the placeholders below.
#   SECRET_KEY:     python -c "import secrets; print(secrets.token_hex(32))"
#   ENCRYPTION_KEY: python -c "import secrets; print(secrets.token_hex(16))"   # 32 chars = 32 bytes
SECRET_KEY=change-me
# Valid 32-byte placeholder so local dev works out of the box — REPLACE for any real
# deploy (Docker: setup.sh generates a unique one). Must be exactly 32 bytes.
ENCRYPTION_KEY=changemechangemechangemechangeme

# App
DEBUG=false
ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# Client IP resolution (rate limiting & login lockout). Wrong values let
# attackers bypass the login lockout by spoofing forwarding headers.
#   0 = no reverse proxy in front (app exposed directly) — DEFAULT, safest.
#   N = number of trusted proxies in front (e.g. 1 for nginx only,
#       2 for Cloudflare + nginx). Client IP is read from X-Forwarded-For,
#       counting N entries from the right.
TRUSTED_PROXY_COUNT=0
# Trust Cloudflare's CF-Connecting-IP header. Enable ONLY when the origin's
# firewall restricts inbound 80/443 to Cloudflare IP ranges (see README deploy).
TRUST_CLOUDFLARE=false

# Let users point the Custom (OpenAI-compatible) AI provider at a private address:
# Ollama on localhost, an LLM container on the Docker network. Turn this on if you
# run the models next to Readfine. Leave it off when other people have accounts on
# this instance, because the endpoint is theirs to type and this is what stops it
# from reaching your internal services. Feed URLs are unaffected either way.
AI_ALLOW_PRIVATE_ENDPOINTS=false

# How much the app logs: DEBUG, INFO, WARNING or ERROR. WARNING (the default)
# keeps the log to things that need attention; INFO adds the running commentary
# from the scheduler and fetcher. Uvicorn's own startup lines show either way.
LOG_LEVEL=WARNING

# Diagnostics: log one line per outbound HTTP request (feed fetch, scrape, readable
# extraction) with host, status, elapsed time and rate-limit headers. Verbose — turn
# it on only while investigating a host that throttles or blocks you, then off again.
LOG_OUTBOUND_REQUESTS=false

# Largest page body Readfine will download, in bytes (feed, scraped page, article).
# Counted after decompression. The default 10 MB clears the biggest real feeds and
# article pages with room to spare; raise it only if a source you want won't fit.
#MAX_FETCH_BYTES=10485760

# Video thumbnails are served through Readfine (/img/video-thumb) so a reader's
# browser never contacts YouTube or Vimeo just by opening an article. The fetched
# images live in this directory, one small JPEG per video; it is only a cache, so
# deleting it loses nothing and a missing image is re-fetched. Point it at a mounted
# volume so it survives a restart.
#THUMB_CACHE_DIR=/data/thumb-cache
# Hard ceiling on that cache (MB). When passed, least-recently-used images are
# dropped. Thumbnails are tens to low hundreds of kB, so 50 MB holds hundreds to a
# couple thousand videos — a ceiling most instances never reach.
#THUMB_CACHE_MAX_MB=50
# A thumbnail not requested in this many days is dropped even below the ceiling; this
# is what clears images for articles that have since been purged. 0 disables the sweep.
#THUMB_CACHE_IDLE_DAYS=30

# Phase-shift the 15-min feed fetch off the default :00/:15/:30/:45 (minutes, 0–14).
# Only needed when another instance shares the host and you don't want both fetching
# at the same moment (e.g. staging alongside production). Leave at 0 for a single box.
#FETCH_SCHEDULE_OFFSET_MIN=0

# How long a signed-in session survives without a visit (days). It slides, so every
# page view resets the clock and only a real absence runs it out. Lower it on a shared
# or public machine; raise it if you'd rather never see the login form.
#SESSION_MAX_AGE_DAYS=30

# Initial admin account (used only on first run)
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-me
