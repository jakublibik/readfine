# Database
DATABASE_URL=postgresql+asyncpg://readfine:readfine@localhost:5432/readfine

# Security – generate each ONCE and keep stable. Changing ENCRYPTION_KEY makes all
# stored API keys / feed passwords undecryptable. (Docker deploys: setup.sh does this for you.)
# With DEBUG=false the app REFUSES to start while these are left at the placeholders below.
#   SECRET_KEY:     python -c "import secrets; print(secrets.token_hex(32))"
#   ENCRYPTION_KEY: python -c "import secrets; print(secrets.token_hex(16))"   # 32 chars = 32 bytes
SECRET_KEY=change-me
# Valid 32-byte placeholder so local dev works out of the box — REPLACE for any real
# deploy (Docker: setup.sh generates a unique one). Must be exactly 32 bytes.
ENCRYPTION_KEY=changemechangemechangemechangeme

# App
DEBUG=false
ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# Client IP resolution (rate limiting & login lockout). Wrong values let
# attackers bypass the login lockout by spoofing forwarding headers.
#   0 = no reverse proxy in front (app exposed directly) — DEFAULT, safest.
#   N = number of trusted proxies in front (e.g. 1 for nginx only,
#       2 for Cloudflare + nginx). Client IP is read from X-Forwarded-For,
#       counting N entries from the right.
TRUSTED_PROXY_COUNT=0
# Trust Cloudflare's CF-Connecting-IP header. Enable ONLY when the origin's
# firewall restricts inbound 80/443 to Cloudflare IP ranges (see README deploy).
TRUST_CLOUDFLARE=false

# Diagnostics: log one line per outbound HTTP request (feed fetch, scrape, readable
# extraction) with host, status, elapsed time and rate-limit headers. Verbose — turn
# it on only while investigating a host that throttles or blocks you, then off again.
LOG_OUTBOUND_REQUESTS=false

# Initial admin account (used only on first run)
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-me
