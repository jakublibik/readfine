__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/
.uv/

# Alembic
alembic/versions/*.pyc

# Test / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Office docs — internal notes/references, never part of the public repo
*.docx

# Docker
*.log

# SSL certificates — never commit private keys
certs/
*.pem
*.key
*.crt

# Tailwind
node_modules/

# Landing page — operator's live copy is per-instance; example template is committed
backend/app/templates/landing.html

