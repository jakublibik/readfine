# Claude Code
.claude/
REVIEW_NOTES.md

# Environment
.env
.env.local
.env.*.local
# Staging instance env (holds secrets); .env.staging.example is committed
.env.staging

# Backup config — holds restic/R2 secrets; example template is committed
backup.env

# Docker Compose override — where local changes to the stack belong, in dev and
# on a self-hosted server alike. Compose merges it automatically, and keeping it
# untracked is what stops a release that edits docker-compose.yml from blocking
# `git pull`. See README → Updating.
docker-compose.override.yml

