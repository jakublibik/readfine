# Readfine backup configuration — copy to `backup.env` and fill in.
# backup.env is gitignored: it holds secrets. Keep it readable only by root
# (chmod 600) since it grants write access to your off-site backup store.

# ── restic repository (Cloudflare R2, S3-compatible) ──────────────────────────
# Create an R2 bucket and an R2 API token with "Object Read & Write" permission,
# then point the repo at the bucket: s3:<S3_API_ENDPOINT>/<BUCKET_NAME>
#
# Copy <S3_API_ENDPOINT> exactly from the bucket's own page (R2 → your bucket →
# Settings → "S3 API"), NOT a generic one — buckets created in a jurisdiction use
# a region-specific host. Examples:
#   default:  https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   EU:       https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com   (note the ".eu.")
# Using the wrong host returns "Access Denied" even with correct credentials.
RESTIC_REPOSITORY=s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET_NAME>

# Encryption passphrase for the restic repo. GENERATE A STRONG ONE and store it
# somewhere SEPARATE from the backups (e.g. a password manager). Without it the
# backups cannot be restored.
RESTIC_PASSWORD=change-me-to-a-long-random-passphrase

# R2 API token credentials (S3 access key / secret). Region must be "auto" for R2.
AWS_ACCESS_KEY_ID=<r2-access-key-id>
AWS_SECRET_ACCESS_KEY=<r2-secret-access-key>
AWS_DEFAULT_REGION=auto

# ── Optional overrides (defaults shown) ───────────────────────────────────────
# COMPOSE_DIR=/opt/readfine        # dir containing docker-compose.yml (default: script dir)
# DB_SERVICE=db
# DB_USER=readfine
# DB_NAME=readfine
# KEEP_DAILY=7
# KEEP_WEEKLY=4
# KEEP_MONTHLY=6

# Optional dead-man's-switch: a URL pinged only on a successful run, so a
# monitor (e.g. healthchecks.io) alerts you if a backup silently stops running.
# HEALTHCHECK_URL=https://hc-ping.com/<uuid>
